{
  "name": "@fffangchenghao/dsh-autoupdater",
  "version": "0.6.5",
  "type": "module",
  "license": "MIT",
  "description": "Maintained fork of dsh-autoupdater with macOS/Windows desktop fixes. Scheduled update checks for DSH itself and installed plugins, applied only in idle windows.",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangchenghao/dsh-autoupdater.git"
  },
  "homepage": "https://github.com/fangchenghao/dsh-autoupdater#readme",
  "bugs": {
    "url": "https://github.com/fangchenghao/dsh-autoupdater/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "auto-update",
    "plugin-manager"
  ],
  "exports": {
    ".": "./main.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "main": "./main.js",
  "scripts": {
    "test": "node test/loader-contract.mjs"
  },
  "files": [
    "main.js",
    "client.js",
    "apply-update.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "undici": "^6.29.1"
  }
}
